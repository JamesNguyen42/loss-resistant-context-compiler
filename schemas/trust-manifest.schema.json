{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/loss-resistant-context-compiler/trust-manifest.schema.json",
  "title": "Externally anchored context compiler trust manifest",
  "type": "object",
  "required": [
    "schema",
    "created_at",
    "artifact_schema_version",
    "artifact_sha256",
    "source_digest",
    "source_count",
    "ledger_complete",
    "archive_chain_head_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "ctxc-trust-manifest-0.1"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    },
    "artifact_schema_version": {
      "const": "1.0"
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_digest": {
      "$ref": "#/$defs/sha256"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "ledger_complete": {
      "const": true
    },
    "archive_chain_head_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
