{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lossless-context-compiler/model-extraction.schema.json",
  "title": "Provider-neutral model extraction response",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text", "provenance"],
        "properties": {
          "kind": {
            "enum": [
              "goal",
              "constraint",
              "user_correction",
              "confirmed_fact",
              "decision",
              "unresolved",
              "exact_error",
              "exact_reference",
              "discarded_attempt",
              "progress",
              "context"
            ]
          },
          "text": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "exact": {"type": "boolean"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "start", "end"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
