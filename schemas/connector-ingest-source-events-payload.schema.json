{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/loss-resistant-context-compiler/connector-ingest-source-events-payload.schema.json",
  "title": "Connector ingest_source_events payload",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "localai-source-event.schema.json"}
    },
    "session_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "checkpoint": {
      "anyOf": [
        {"$ref": "incremental-checkpoint.schema.json"},
        {"type": "null"}
      ]
    },
    "archive_chain_head_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64},
        {"type": "null"}
      ]
    }
  },
  "additionalProperties": false
}
