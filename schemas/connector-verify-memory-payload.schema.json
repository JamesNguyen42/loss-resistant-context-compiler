{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/loss-resistant-context-compiler/connector-verify-memory-payload.schema.json",
  "title": "Connector verify_memory payload",
  "type": "object",
  "required": ["bundle"],
  "properties": {
    "bundle": {"$ref": "context-bundle.schema.json"},
    "session_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "checkpoint": {
      "anyOf": [
        {"$ref": "incremental-checkpoint.schema.json"},
        {"type": "null"}
      ]
    },
    "source_records": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "incremental-checkpoint.schema.json#/$defs/canonicalSourceRecord"
          }
        },
        {"type": "null"}
      ]
    },
    "events": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "localai-source-event.schema.json"}
        },
        {"type": "null"}
      ]
    },
    "expected_archive_chain_head_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64},
        {"type": "null"}
      ]
    }
  },
  "additionalProperties": false
}
