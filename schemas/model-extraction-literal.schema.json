{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lossless-context-compiler/model-extraction-literal.schema.json",
  "title": "Provider-neutral unique-literal model extraction response",
  "description": "An exact-source-literal response whose character offsets are derived only after a unique match in every cited source.",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text", "source_ids"],
        "properties": {
          "kind": {
            "enum": [
              "goal",
              "constraint",
              "user_correction",
              "confirmed_fact",
              "decision",
              "unresolved",
              "exact_error",
              "exact_reference",
              "discarded_attempt",
              "progress",
              "context"
            ]
          },
          "text": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "exact": {"type": "boolean"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
