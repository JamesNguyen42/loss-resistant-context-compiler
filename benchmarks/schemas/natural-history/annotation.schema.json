{
  "$id": "https://example.invalid/loss-resistant-context-compiler/benchmarks/natural-history-annotation-0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "annotator": {
      "additionalProperties": false,
      "properties": {
        "attestation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "blind_to_peer_labels": {
          "const": true
        },
        "completed_at_utc": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "independent": {
          "const": true
        }
      },
      "required": [
        "id",
        "independent",
        "blind_to_peer_labels",
        "completed_at_utc",
        "attestation_sha256"
      ],
      "type": "object"
    },
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "histories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "history_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "labels": {
            "items": {
              "$ref": "#/$defs/label"
            },
            "maxItems": 10000,
            "type": "array"
          }
        },
        "required": [
          "history_id",
          "labels"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "ctxc-natural-history-annotation-0.1"
    }
  },
  "required": [
    "schema",
    "corpus_sha256",
    "annotator",
    "histories",
    "annotation_sha256"
  ],
  "title": "Natural-history independent annotation contract",
  "type": "object",
  "$defs": {
    "label": {
      "additionalProperties": false,
      "properties": {
        "exact": {
          "type": "boolean"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "goal",
            "constraint",
            "user_correction",
            "confirmed_fact",
            "decision",
            "unresolved",
            "exact_error",
            "exact_reference",
            "discarded_attempt",
            "progress",
            "context"
          ]
        },
        "protected": {
          "type": "boolean"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/span"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "discarded",
            "conflicting"
          ]
        },
        "text": {
          "maxLength": 1000000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "status",
        "exact",
        "protected",
        "provenance"
      ],
      "type": "object"
    },
    "span": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 1,
          "type": "integer"
        },
        "quote": {
          "maxLength": 1000000,
          "minLength": 1,
          "type": "string"
        },
        "quote_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "start",
        "end",
        "quote",
        "quote_sha256"
      ],
      "type": "object"
    }
  }
}
