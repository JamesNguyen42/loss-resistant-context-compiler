{
  "$id": "https://example.invalid/loss-resistant-context-compiler/benchmarks/natural-history-adjudication-0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adjudication_sha256": {
      "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64,
      "type": "string"
    },
    "adjudicator": {
      "additionalProperties": false,
      "properties": {
        "attestation_sha256": {
          "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64,
          "type": "string"
        },
        "complete": {
          "const": true
        },
        "completed_at_utc": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z(?![\\s\\S])", "minLength": 20, "maxLength": 20,
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "id",
        "complete",
        "completed_at_utc",
        "attestation_sha256"
      ],
      "type": "object"
    },
    "annotation_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64,
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64,
      "type": "string"
    },
    "histories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "decisions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "disagreement_label_sha256": {
                  "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64,
                  "type": "string"
                },
                "final_label_sha256": {
                  "oneOf": [
                    {
                      "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "resolution": {
                  "enum": [
                    "accept",
                    "reject",
                    "replace"
                  ]
                }
              },
              "required": [
                "disagreement_label_sha256",
                "resolution",
                "final_label_sha256"
              ],
              "type": "object"
            },
            "maxItems": 20000,
            "type": "array"
          },
          "final_labels": {
            "items": {
              "$ref": "annotation.schema.json#/$defs/label"
            },
            "maxItems": 10000,
            "type": "array"
          },
          "history_id": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}(?![\\s\\S])",
            "type": "string"
          }
        },
        "required": [
          "history_id",
          "final_labels",
          "decisions"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "ctxc-natural-history-adjudication-0.1"
    }
  },
  "required": [
    "schema",
    "corpus_sha256",
    "annotation_sha256s",
    "adjudicator",
    "histories",
    "adjudication_sha256"
  ],
  "title": "Natural-history adjudication contract",
  "type": "object"
}
